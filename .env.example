DATABASE_URL=postgres://lavanda:change-me@127.0.0.1:5432/lavanda?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
PUBLIC_URL=http://localhost:3000
COOKIE_SECURE=false
# First administrator: used only by npm run admin:create, never auto-created.
ADMIN_EMAIL=
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=Администратор
# SMTP for password recovery and invitations: 465 = SSL/TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional: recipient of booking creation/cancellation emails. Empty disables them.
ADMIN_NOTIFICATION_EMAIL=
# Optional: set both to enable admin booking notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
